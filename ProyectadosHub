tabs.fast.equipPetsByNameV2 = function(petNames, maxPets)
    maxPets = maxPets or 12
    local uniquePets = utils.playerData.Player.petsFolder.Unique
    local equipped = 0
    
    for _, folder in pairs(utils.playerData.Player.petsFolder:GetChildren()) do
        if folder:IsA("Folder") and folder.Name ~= "Unique" then
            for _, pet in pairs(folder:GetChildren()) do
                pcall(function() services.ReplicatedStorage.rEvents.equipPetEvent:FireServer("unequipPet", pet) end)
            end
        end
    end
    task.wait(0.1)
    
    for _, petName in ipairs(petNames) do
        if equipped >= maxPets then break end
        for _, pet in pairs(uniquePets:GetChildren()) do
            if equipped >= maxPets then break end
            if pet.Name == petName then
                pcall(function() services.ReplicatedStorage.rEvents.equipPetEvent:FireServer("equipPet", pet) end)
                equipped = equipped + 1
                task.wait(0.05)
            end
        end
    end
    return equipped
end

tabs.fast.FastRebirthV2Worker = function()
    local startRebirths = tabs.fast.FastRebirthV2Data.Rebirths.Value
    tabs.fast.FastRebirthV2Data.TotalRebirths = 0
    local lastCheck = tick()
    local lastRebirthCount = startRebirths
    
    while utils.isCurrent() and tabs.fast.FastRebirthV2Data.Running do
        if tabs.fast.FastRebirthV2Data.TargetRebirths > 0 and tabs.fast.FastRebirthV2Data.Rebirths.Value >= tabs.fast.FastRebirthV2Data.TargetRebirths then
            tabs.fast.FastRebirthV2Status.Text = "Status: ✅ Target alcanzado!"
            tabs.fast.FastRebirthV2Status.TextColor3 = Color3.fromRGB(80, 255, 120)
            tabs.fast.FastRebirthV2Data.Running = false
            break
        end
        
        tabs.fast.FastRebirthV2Status.Text = "Status: ⚡ Equipando velocidad..."
        tabs.fast.FastRebirthV2Status.TextColor3 = Color3.fromRGB(255, 200, 80)
        pcall(function() tabs.fast.equipPetsByNameV2(tabs.fast.FastRebirthV2Data.RepPets, 12) end)
        task.wait(0.3)
        
        local currentRebirths = tabs.fast.FastRebirthV2Data.Rebirths.Value
        local targetStrength = 5000 + currentRebirths * 2550
        local repsPerBurst = utils.playerData.Player.MembershipType == Enum.MembershipType.Premium and 6 or 12
        
        tabs.fast.FastRebirthV2Status.Text = "Status: 💪 Farmeando... " .. utils.formatNumber(tabs.fast.FastRebirthV2Data.Strength.Value) .. " / " .. utils.formatNumber(targetStrength)
        tabs.fast.FastRebirthV2Status.TextColor3 = Color3.fromRGB(80, 255, 120)
        
        while utils.isCurrent() and tabs.fast.FastRebirthV2Data.Running and tabs.fast.FastRebirthV2Data.Strength.Value < targetStrength do
            for i = 1, repsPerBurst do
                pcall(function() utils.remotes.MuscleEvent:FireServer("rep") end)
            end
            task.wait(0.02)
            tabs.fast.FastRebirthV2Stats.Text = "Rebirths: " .. utils.formatWithCommas(tabs.fast.FastRebirthV2Data.Rebirths.Value) .. " | Gained: " .. utils.formatWithCommas(tabs.fast.FastRebirthV2Data.Rebirths.Value - startRebirths)
        end
        
        if utils.isCurrent() and tabs.fast.FastRebirthV2Data.Running and tabs.fast.FastRebirthV2Data.Strength.Value >= targetStrength then
            if tabs.fast.FastRebirthV2Data.UsePackPets then
                tabs.fast.FastRebirthV2Status.Text = "Status: 🎁 Equipando packs..."
                tabs.fast.FastRebirthV2Status.TextColor3 = Color3.fromRGB(255, 150, 255)
                pcall(function() tabs.fast.equipPetsByNameV2(tabs.fast.FastRebirthV2Data.PackPets, 12) end)
                task.wait(0.5)
            end
            
            tabs.fast.FastRebirthV2Status.Text = "Status: 🔄 Haciendo rebirth..."
            tabs.fast.FastRebirthV2Status.TextColor3 = Color3.fromRGB(255, 200, 80)
            
            local rebirthValueBefore = tabs.fast.FastRebirthV2Data.Rebirths.Value
            local attempts = 0
            
            repeat
                pcall(function() services.ReplicatedStorage.rEvents.rebirthRemote:InvokeServer("rebirthRequest") end)
                task.wait(0.05)
                attempts = attempts + 1
            until not tabs.fast.FastRebirthV2Data.Running or tabs.fast.FastRebirthV2Data.Rebirths.Value > rebirthValueBefore or attempts >= 50
            
            if tabs.fast.FastRebirthV2Data.Rebirths.Value > rebirthValueBefore then
                tabs.fast.FastRebirthV2Data.TotalRebirths = tabs.fast.FastRebirthV2Data.TotalRebirths + (tabs.fast.FastRebirthV2Data.Rebirths.Value - rebirthValueBefore)
            end
            
            if tabs.fast.FastRebirthV2Data.UseGolems then
                tabs.fast.FastRebirthV2Status.Text = "Status: 🐾 Re-equipando golems..."
                tabs.fast.FastRebirthV2Status.TextColor3 = Color3.fromRGB(150, 200, 255)
                task.wait(0.5)
                pcall(function() tabs.fast.equipPetsByNameV2(tabs.fast.FastRebirthV2Data.GolemPets, 12) end)
            end
        end
        
        if tick() - lastCheck >= 1 then
            local currentCount = tabs.fast.FastRebirthV2Data.Rebirths.Value
            local gained = currentCount - lastRebirthCount
            tabs.fast.FastRebirthV2Speed.Text = "Speed: " .. gained .. " rebirths/s"
            lastRebirthCount = currentCount
            lastCheck = tick()
        end
        task.wait(0.3)
    end
    tabs.fast.FastRebirthV2Data.WorkerActive = false
end

