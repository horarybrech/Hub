local function equipPetsByNameV2(petNames, maxPets)
    maxPets = maxPets or 12
    local uniquePets = utils.playerData.Player.petsFolder.Unique
    local equipped = 0
    for _, folder in pairs(utils.playerData.Player.petsFolder:GetChildren()) do
        if folder:IsA("Folder") and folder.Name ~= "Unique" then
            for _, pet in pairs(folder:GetChildren()) do
                pcall(function() services.ReplicatedStorage.rEvents.equipPetEvent:FireServer("unequipPet", pet) end)
            end
        end
    end
    task.wait(0.1)
    for _, petName in ipairs(petNames) do
        if equipped >= maxPets then break end
        for _, pet in pairs(uniquePets:GetChildren()) do
            if equipped >= maxPets then break end
            if pet.Name == petName then
                pcall(function() services.ReplicatedStorage.rEvents.equipPetEvent:FireServer("equipPet", pet) end)
                equipped = equipped + 1
                task.wait(0.05)
            end
        end
    end
    return equipped
end

tabs.fullRebirth.FastRebirthV2Worker = function()
    local startRebirths = tabs.fullRebirth.FastRebirthV2Data.Rebirths.Value
    tabs.fullRebirth.FastRebirthV2Data.TotalRebirths = 0
    local lastCheck = tick()
    local startTime = tick()
    
    while utils.isCurrent() and tabs.fullRebirth.FastRebirthV2Data.Running do
        if tabs.fullRebirth.FastRebirthV2Data.TargetRebirths > 0 and tabs.fullRebirth.FastRebirthV2Data.Rebirths.Value >= tabs.fullRebirth.FastRebirthV2Data.TargetRebirths then
            tabs.fullRebirth.FastRebirthV2Status.Text = "Status: ✅ Target alcanzado!"
            tabs.fullRebirth.FastRebirthV2Status.TextColor3 = Color3.fromRGB(80, 255, 120)
            tabs.fullRebirth.FastRebirthV2Data.Running = false
            break
        end
        
        pcall(function() equipPetsByNameV2(tabs.fullRebirth.FastRebirthV2Data.RepPets, 12) end)
        task.wait(0.3)
        
        local currentRebirths = tabs.fullRebirth.FastRebirthV2Data.Rebirths.Value
        local targetStrength = 5000 + currentRebirths * 2550
        local repsPerBurst = utils.playerData.Player.MembershipType == Enum.MembershipType.Premium and 6 or 12
        
        while utils.isCurrent() and tabs.fullRebirth.FastRebirthV2Data.Running and tabs.fullRebirth.FastRebirthV2Data.Strength.Value < targetStrength do
            for i = 1, repsPerBurst do
                pcall(function() utils.remotes.MuscleEvent:FireServer("rep") end)
            end
            task.wait(0.02)
        end
        
        if utils.isCurrent() and tabs.fullRebirth.FastRebirthV2Data.Running and tabs.fullRebirth.FastRebirthV2Data.Strength.Value >= targetStrength then
            if tabs.fullRebirth.FastRebirthV2Data.UsePackPets then
                pcall(function() equipPetsByNameV2(tabs.fullRebirth.FastRebirthV2Data.PackPets, 12) end)
                task.wait(0.4)
            end
            
            local rebirthValueBefore = tabs.fullRebirth.FastRebirthV2Data.Rebirths.Value
            local attempts = 0
            repeat
                pcall(function() services.ReplicatedStorage.rEvents.rebirthRemote:InvokeServer("rebirthRequest") end)
                task.wait(0.05)
                attempts = attempts + 1
            until not tabs.fullRebirth.FastRebirthV2Data.Running or tabs.fullRebirth.FastRebirthV2Data.Rebirths.Value > rebirthValueBefore or attempts >= 40
            
            if tabs.fullRebirth.FastRebirthV2Data.UseGolems then
                task.wait(0.4)
                pcall(function() equipPetsByNameV2(tabs.fullRebirth.FastRebirthV2Data.GolemPets, 12) end)
            end
        end
        
        local currentCount = tabs.fullRebirth.FastRebirthV2Data.Rebirths.Value
        local gained = currentCount - startRebirths
        tabs.fullRebirth.FastRebirthV2Stats.Text = "Rebirths: " .. utils.formatWithCommas(currentCount) .. " | Gained: " .. utils.formatWithCommas(gained)
        
        if tick() - lastCheck >= 1 then
            local secElapsed = tick() - startTime
            if gained > 0 then
                local avgSecPerRb = secElapsed / gained
                tabs.fullRebirth.AvgTimeLabel.Text = string.format("Velocidad: %.2f s/rebirth", avgSecPerRb)
                
                if tabs.fullRebirth.TargetRebirths > 0 then
                    local missing = math.max(0, tabs.fullRebirth.TargetRebirths - currentCount)
                    tabs.fullRebirth.MissingLabel.Text = "Rebirths Faltantes: " .. utils.formatWithCommas(missing)
                    local etaSec = missing * avgSecPerRb
                    local etaH = math.floor(etaSec / 3600)
                    local etaM = math.floor((etaSec % 3600) / 60)
                    local etaS = math.floor(etaSec % 60)
                    tabs.fullRebirth.EtaLabel.Text = string.format("Tiempo Estimado: %dh %dm %ds", etaH, etaM, etaS)
                else
                    tabs.fullRebirth.MissingLabel.Text = "Rebirths Faltantes: Infinito"
                    tabs.fullRebirth.EtaLabel.Text = "Tiempo Estimado: --h --m --s"
                end
            end
            lastCheck = tick()
        end
        task.wait(0.3)
    end
    tabs.fullRebirth.FastRebirthV2Data.WorkerActive = false
end

