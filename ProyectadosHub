local function tpE(pos)
    pcall(function()
        local char = lp.player.Character or lp.player.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart")
        hrp.CFrame = CFrame.new(pos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.4)
        services.VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.1)
        services.VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

tabs.other:AddButton("Industrial Lift", function() tpE(Vector3.new(-5491.68945, 81.2379913, 4643.85791)) end)
tabs.other:AddButton("Industrial Squat", function() tpE(Vector3.new(-5217.25049, 89.8445511, 5416.01025)) end)
tabs.other:AddButton("Overcharged Lift", function() tpE(Vector3.new(-3023.363, 151.797, 4696.859)) end)

tabs.other:AddButton("Anti Lag (for bad devices)", function()
    pcall(function()
        for _, gui in pairs(lp.player:WaitForChild("PlayerGui"):GetChildren()) do
            if gui:IsA("ScreenGui") then gui:Destroy() end
        end
        for _, v in pairs(services.Lighting:GetChildren()) do
            if v:IsA("Sky") or v:IsA("Atmosphere") then v:Destroy() end
        end
        services.Lighting.Brightness = 0
        services.Lighting.GlobalShadows = false
        workspace.Terrain.WaterTransparency = 1
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("PointLight") or obj:IsA("SpotLight") then
                obj:Destroy()
            elseif obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
            end
        end
    end)
end)

