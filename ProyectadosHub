    ["Rare Boss Pet"] = {repSpeed = 7, strength = 0, durability = 0, rebirth = 0},
    ["Epic Boss Pet"] = {repSpeed = 10, strength = 0, durability = 0, rebirth = 0},
    ["Rainbow Boss Pet"] = {repSpeed = 10, strength = 7, durability = 0, rebirth = 0},
    ["Legendary Boss Pet"] = {repSpeed = 10, strength = 10, durability = 0, rebirth = 0},
    ["Mythic Boss Pet"] = {repSpeed = 10, strength = 20, durability = 0, rebirth = 0},
    ["Inferno Drake"] = {repSpeed = 40, strength = 0, durability = 0, rebirth = 0},
}
local MAX_PET_SLOTS = 12
local TARGET_REP_SPEED = 100

local function unequipConfiguredPets()
    for _, folder in ipairs(lp.player.petsFolder:GetChildren()) do
        if folder:IsA("Folder") then
            for _, pet in ipairs(folder:GetChildren()) do
                services.ReplicatedStorage.rEvents.equipPetEvent:FireServer("unequipPet", pet)
            end
        end
    end
    task.wait(0.1)
end

local function equipConfiguredPet(pet)
    services.ReplicatedStorage.rEvents.equipPetEvent:FireServer("equipPet", pet)
end

local function getOwnedConfiguredPets()
    local ownedPets = {}
    for _, folder in ipairs(lp.player.petsFolder:GetChildren()) do
        if folder:IsA("Folder") then
            for _, pet in ipairs(folder:GetChildren()) do
                local config = PETS[pet.Name]
                if config then
                    table.insert(ownedPets, {
                        instance = pet, name = pet.Name,
                        repSpeed = config.repSpeed or 0, strength = config.strength or 0,
                        durability = config.durability or 0, rebirth = config.rebirth or 0,
                    })
                end
            end
        end
    end
    return ownedPets
end

local function equipBestFarmingPets()
    unequipConfiguredPets()
    local pets = getOwnedConfiguredPets()
    local equipped = {}
    local equippedCount = 0
    local currentRepSpeed = 0
    table.sort(pets, function(a, b) return a.repSpeed > b.repSpeed end)
    for _, pet in ipairs(pets) do
        if equippedCount >= MAX_PET_SLOTS or currentRepSpeed >= TARGET_REP_SPEED then break end
        if pet.repSpeed > 0 then
            equipConfiguredPet(pet.instance)
            equipped[pet.instance] = true
            equippedCount = equippedCount + 1
            currentRepSpeed = currentRepSpeed + pet.repSpeed
        end
    end
    local remainingPets = {}
    for _, pet in ipairs(pets) do
        if not equipped[pet.instance] then table.insert(remainingPets, pet) end
    end
    table.sort(remainingPets, function(a, b) return (a.strength + a.durability) > (b.strength + b.durability) end)
    for _, pet in ipairs(remainingPets) do
        if equippedCount >= MAX_PET_SLOTS then break end
        if pet.strength > 0 or pet.durability > 0 then
            equipConfiguredPet(pet.instance)
            equipped[pet.instance] = true
            equippedCount = equippedCount + 1
        end
    end
    return currentRepSpeed, equippedCount
end

local function equipBestRebirthPets()
    unequipConfiguredPets()
    local pets = getOwnedConfiguredPets()
    table.sort(pets, function(a, b) return a.rebirth > b.rebirth end)
    local equippedCount = 0
    local totalRebirthMultiplier = 0
    for _, pet in ipairs(pets) do
        if equippedCount >= MAX_PET_SLOTS then break end
        if pet.rebirth > 0 then
            equipConfiguredPet(pet.instance)
            equippedCount = equippedCount + 1
            totalRebirthMultiplier = totalRebirthMultiplier + pet.rebirth
        end
    end
    return totalRebirthMultiplier, equippedCount
end

