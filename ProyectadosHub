tabs.fullFarm.updateStats = function()
    tabs.fullFarm.StrengthStats.Text = "Strength: " .. formatCurrentStat(tabs.fullFarm.strength.Value) .. " | Gained: " .. formatNumberSilence(tabs.fullFarm.strength.Value - tabs.fullFarm.startStrength)
    tabs.fullFarm.DurabilityStats.Text = "Durability: " .. formatCurrentStat(tabs.fullFarm.durability.Value) .. " | Gained: " .. formatNumberSilence(tabs.fullFarm.durability.Value - tabs.fullFarm.startDurability)
end

tabs.fullFarm.calculatePace = function()
    if not tabs.fullFarm.running or not tabs.fullFarm.timerStarted then return end
    if tick() - tabs.fullFarm.lastCalculationAt < tabs.fullFarm.calculationInterval then return end
    tabs.fullFarm.calculationElapsed = tick() - tabs.fullFarm.lastCalculationAt
    tabs.fullFarm.strengthDelta = tabs.fullFarm.strength.Value - tabs.fullFarm.lastCalculatedStrength
    tabs.fullFarm.durabilityDelta = tabs.fullFarm.durability.Value - tabs.fullFarm.lastCalculatedDurability
    tabs.fullFarm.strengthPacePerSecond = tabs.fullFarm.strengthDelta / tabs.fullFarm.calculationElapsed
    tabs.fullFarm.durabilityPacePerSecond = tabs.fullFarm.durabilityDelta / tabs.fullFarm.calculationElapsed
    if tabs.fullFarm.strengthDelta > 0 then tabs.fullFarm.StrengthPace.Text = "Str Pace: " .. formatPaceSilence(tabs.fullFarm.strengthPacePerSecond) end
    if tabs.fullFarm.durabilityDelta > 0 then tabs.fullFarm.DurabilityPace.Text = "Dura Pace: " .. formatPaceSilence(tabs.fullFarm.durabilityPacePerSecond) end
    tabs.fullFarm.averageElapsed = tabs.fullFarm.totalElapsed + tick() - tabs.fullFarm.startedAt
    tabs.fullFarm.averageStrengthPerSecond = (tabs.fullFarm.strength.Value - tabs.fullFarm.startStrength) / tabs.fullFarm.averageElapsed
    tabs.fullFarm.averageDurabilityPerSecond = (tabs.fullFarm.durability.Value - tabs.fullFarm.startDurability) / tabs.fullFarm.averageElapsed
    tabs.fullFarm.StrengthAverage.Text = "Str Ø: " .. formatPaceSilence(tabs.fullFarm.averageStrengthPerSecond)
    tabs.fullFarm.DurabilityAverage.Text = "Dura Ø: " .. formatPaceSilence(tabs.fullFarm.averageDurabilityPerSecond)
    tabs.fullFarm.lastCalculationAt = tick()
    tabs.fullFarm.lastCalculatedStrength = tabs.fullFarm.strength.Value
    tabs.fullFarm.lastCalculatedDurability = tabs.fullFarm.durability.Value
end

tabs.fullFarm.updateAdaptiveRate = function()
    tabs.fullFarm.controlNow = tick()
    tabs.fullFarm.controlElapsed = tabs.fullFarm.controlNow - tabs.fullFarm.lastControlAt
    if tabs.fullFarm.controlElapsed < tabs.fullFarm.controlInterval then return end
    tabs.fullFarm.serverProgress = tabs.fullFarm.strength.Value > tabs.fullFarm.lastControlStrength or tabs.fullFarm.durability.Value > tabs.fullFarm.lastControlDurability
    if tabs.fullFarm.serverProgress then
        tabs.fullFarm.stalledIntervals = 0
        tabs.fullFarm.sendRate = math.min(tabs.fullFarm.maxSendRate, tabs.fullFarm.sendRate * 1.12)
        tabs.fullFarm.Status.Text = "Status: Farming | " .. formatNumberSilence(tabs.fullFarm.sendRate) .. " reps/s"
        tabs.fullFarm.Status.TextColor3 = Color3.fromRGB(80, 255, 120)
    else
        tabs.fullFarm.stalledIntervals = tabs.fullFarm.stalledIntervals + 1
    end
    if tabs.fullFarm.stalledIntervals >= 2 then
        tabs.fullFarm.sendRate = math.max(tabs.fullFarm.initialSendRate, tabs.fullFarm.sendRate * 0.65)
        tabs.fullFarm.sendTokens = 0
        tabs.fullFarm.Status.Text = "Status: Slowing for server | " .. formatNumberSilence(tabs.fullFarm.sendRate) .. " reps/s"
        tabs.fullFarm.Status.TextColor3 = Color3.fromRGB(255, 180, 70)
    end
    tabs.fullFarm.lastControlAt = tabs.fullFarm.controlNow
    tabs.fullFarm.lastControlStrength = tabs.fullFarm.strength.Value
    tabs.fullFarm.lastControlDurability = tabs.fullFarm.durability.Value
end

tabs.fullFarm.workerLoop = function()
    tabs.fullFarm.lastLoopAt = os.clock()
    while tabs.fullFarm.running do
        tabs.fullFarm.loopNow = os.clock()
        tabs.fullFarm.loopElapsed = math.min(0.1, tabs.fullFarm.loopNow - tabs.fullFarm.lastLoopAt)
        tabs.fullFarm.lastLoopAt = tabs.fullFarm.loopNow
        tabs.fullFarm.updateAdaptiveRate()
        tabs.fullFarm.sendTokens = math.min(tabs.fullFarm.maxBurst, tabs.fullFarm.sendTokens + tabs.fullFarm.sendRate * tabs.fullFarm.loopElapsed)
        tabs.fullFarm.burstLimit = math.max(1, math.min(tabs.fullFarm.maxBurst, math.ceil(tabs.fullFarm.sendRate * 0.05)))
        tabs.fullFarm.sendCount = math.min(math.floor(tabs.fullFarm.sendTokens), tabs.fullFarm.burstLimit)
        tabs.fullFarm.repIndex = 1
        while tabs.fullFarm.repIndex <= tabs.fullFarm.sendCount do
            utils.remotes.MuscleEvent:FireServer("rep")
            tabs.fullFarm.repIndex = tabs.fullFarm.repIndex + 1
        end
        tabs.fullFarm.sendTokens = tabs.fullFarm.sendTokens - tabs.fullFarm.sendCount
        services.RunService.Heartbeat:Wait()
    end
    tabs.fullFarm.workerActive = false
end

tabs.fullFarm.startWorker = function()
    if tabs.fullFarm.workerActive then return end
    tabs.fullFarm.workerActive = true
    task.spawn(tabs.fullFarm.workerLoop)
end

