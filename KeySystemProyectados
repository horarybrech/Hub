local KeySystem = {}

function KeySystem:Init(config)
	config = config or {}
	local tweenService = game:GetService("TweenService")
	local coreGui = game:GetService("CoreGui")
	local players = game:GetService("Players")
	local localPlayer = players.LocalPlayer

	if not localPlayer then
		return false
	end

	local acceptedKeys = config.Keys or {}
	local whitelist = config.Whitelist or {}
	local fileName = config.FileName or "Proyectados_Key.txt"
	local titleText = config.Title or "PROYECTADOS HUB"
	local keyLink = config.KeyLink or "https://link-center.net/10253076/q1AAl7og4pTF"
	local kickTime = tonumber(config.KickTimeout) or 60

	local verified = false
	local closing = false

	local function cleanKey(str)
		return tostring(str or ""):match("^%s*(.-)%s*$")
	end

	local function safeWriteFile(name, content)
		pcall(function()
			if type(writefile) == "function" then
				writefile(name, tostring(content or ""))
			end
		end)
	end

	local function safeReadSavedKey(name)
		local found = false
		pcall(function()
			if type(isfile) == "function" and type(readfile) == "function" and isfile(name) then
				local savedKey = cleanKey(readfile(name))
				if acceptedKeys[savedKey] then
					found = true
				end
			end
		end)
		return found
	end

	local function safeCopy(text)
		pcall(function()
			local clipFn = setclipboard or toclipboard or set_clipboard or (Clipboard and Clipboard.set)
			if type(clipFn) == "function" then
				clipFn(tostring(text or ""))
			end
		end)
	end

	-- 1. Whitelist check
	local playerName = localPlayer.Name
	if playerName and whitelist[playerName] then
		return true
	end

	-- 2. Saved key check
	if safeReadSavedKey(fileName) then
		return true
	end

	-- 3. UI Setup
	local parentGui = nil
	local okCore = pcall(function()
		local testFrame = Instance.new("Frame")
		testFrame.Parent = coreGui
		testFrame:Destroy()
		parentGui = coreGui
	end)
	if not okCore or not parentGui then
		parentGui = localPlayer:FindFirstChild("PlayerGui") or localPlayer:WaitForChild("PlayerGui", 10)
	end
	if not parentGui then
		return false
	end

	pcall(function()
		local oldGui = parentGui:FindFirstChild(titleText .. "_KeyUI")
		if oldGui then
			oldGui:Destroy()
		end
	end)

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = titleText .. "_KeyUI"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = parentGui

	local mainFrame = Instance.new("Frame")
	mainFrame.Name = "MainFrame"
	mainFrame.Size = UDim2.new(0, 0, 0, 0)
	mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
	mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	mainFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
	mainFrame.BorderSizePixel = 0
	mainFrame.Active = true
	mainFrame.Draggable = true
	mainFrame.ClipsDescendants = true
	mainFrame.Parent = screenGui

	local sizeConstraint = Instance.new("UISizeConstraint")
	sizeConstraint.MaxSize = Vector2.new(380, 295)
	sizeConstraint.MinSize = Vector2.new(280, 225)
	sizeConstraint.Parent = mainFrame

	local uiCorner = Instance.new("UICorner")
	uiCorner.CornerRadius = UDim.new(0, 12)
	uiCorner.Parent = mainFrame

	local uiStroke = Instance.new("UIStroke")
	uiStroke.Color = Color3.fromRGB(138, 43, 226)
	uiStroke.Thickness = 2
	uiStroke.Parent = mainFrame

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(26, 22, 38)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 15, 22))
	})
	gradient.Rotation = 90
	gradient.Parent = mainFrame

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(1, -20, 0, 36)
	titleLabel.Position = UDim2.new(0, 10, 0, 14)
	titleLabel.Text = titleText
	titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextSize = 21
	titleLabel.Parent = mainFrame

	local statusLabel = Instance.new("TextLabel")
	statusLabel.Size = UDim2.new(1, -20, 0, 22)
	statusLabel.Position = UDim2.new(0, 10, 0, 48)
	statusLabel.Text = "Introduce tu Key para continuar"
	statusLabel.TextColor3 = Color3.fromRGB(175, 175, 190)
	statusLabel.BackgroundTransparency = 1
	statusLabel.Font = Enum.Font.Gotham
	statusLabel.TextSize = 13
	statusLabel.Parent = mainFrame

	local textBox = Instance.new("TextBox")
	textBox.Size = UDim2.new(0.86, 0, 0, 42)
	textBox.Position = UDim2.new(0.5, 0, 0.31, 0)
	textBox.AnchorPoint = Vector2.new(0.5, 0)
	textBox.PlaceholderText = "Escribe la Key aquí..."
	textBox.Text = ""
	textBox.ClearTextOnFocus = false
	textBox.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
	textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	textBox.PlaceholderColor3 = Color3.fromRGB(125, 125, 140)
	textBox.Font = Enum.Font.GothamMedium
	textBox.TextSize = 14
	textBox.Parent = mainFrame

	local tbCorner = Instance.new("UICorner")
	tbCorner.CornerRadius = UDim.new(0, 8)
	tbCorner.Parent = textBox

	local tbStroke = Instance.new("UIStroke")
	tbStroke.Color = Color3.fromRGB(65, 65, 85)
	tbStroke.Thickness = 1
	tbStroke.Parent = textBox

	local submitButton = Instance.new("TextButton")
	submitButton.Size = UDim2.new(0.86, 0, 0, 42)
	submitButton.Position = UDim2.new(0.5, 0, 0.52, 0)
	submitButton.AnchorPoint = Vector2.new(0.5, 0)
	submitButton.Text = "VERIFICAR KEY"
	submitButton.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
	submitButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	submitButton.Font = Enum.Font.GothamBold
	submitButton.TextSize = 14
	submitButton.AutoButtonColor = true
	submitButton.Parent = mainFrame

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 8)
	btnCorner.Parent = submitButton

	local getKeyButton = Instance.new("TextButton")
	getKeyButton.Size = UDim2.new(0.86, 0, 0, 40)
	getKeyButton.Position = UDim2.new(0.5, 0, 0.72, 0)
	getKeyButton.AnchorPoint = Vector2.new(0.5, 0)
	getKeyButton.Text = "OBTENER KEY"
	getKeyButton.BackgroundColor3 = Color3.fromRGB(40, 35, 58)
	getKeyButton.TextColor3 = Color3.fromRGB(215, 185, 255)
	getKeyButton.Font = Enum.Font.GothamBold
	getKeyButton.TextSize = 13
	getKeyButton.AutoButtonColor = true
	getKeyButton.Parent = mainFrame

	local getKeyCorner = Instance.new("UICorner")
	getKeyCorner.CornerRadius = UDim.new(0, 8)
	getKeyCorner.Parent = getKeyButton

	local getKeyStroke = Instance.new("UIStroke")
	getKeyStroke.Color = Color3.fromRGB(138, 43, 226)
	getKeyStroke.Thickness = 1
	getKeyStroke.Parent = getKeyButton

	pcall(function()
		tweenService:Create(
			mainFrame,
			TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Size = UDim2.new(0.85, 0, 0.6, 0) }
		):Play()
	end)

	local resetToken = 0
	getKeyButton.MouseButton1Click:Connect(function()
		if closing then return end
		resetToken = resetToken + 1
		local currentToken = resetToken

		safeCopy(keyLink)

		pcall(function()
			getKeyButton.Text = "✔ LINK COPIADO AL PORTAPAPELES"
			statusLabel.Text = "Pega el link en tu navegador para obtener la Key"
			statusLabel.TextColor3 = Color3.fromRGB(120, 255, 150)
		end)

		task.delay(2.5, function()
			if closing or currentToken ~= resetToken then return end
			pcall(function()
				if getKeyButton and getKeyButton.Parent then
					getKeyButton.Text = "OBTENER KEY"
				end
				if statusLabel and statusLabel.Parent then
					statusLabel.Text = "Introduce tu Key para continuar"
					statusLabel.TextColor3 = Color3.fromRGB(175, 175, 190)
				end
			end)
		end)
	end)

	submitButton.MouseButton1Click:Connect(function()
		if closing or verified then return end

		local rawText = ""
		pcall(function()
			rawText = textBox.Text
		end)
		local inputKey = cleanKey(rawText)

		if acceptedKeys[inputKey] then
			closing = true
			verified = true

			pcall(function()
				submitButton.Active = false
				getKeyButton.Active = false
				textBox.TextEditable = false
				statusLabel.Text = "✔ Key Correcta! Cargando Hub..."
				statusLabel.TextColor3 = Color3.fromRGB(120, 255, 150)
			end)

			safeWriteFile(fileName, inputKey)

			task.spawn(function()
				pcall(function()
					local closeTween = tweenService:Create(
						mainFrame,
						TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
						{ Size = UDim2.new(0, 0, 0, 0) }
					)
					closeTween:Play()
					closeTween.Completed:Wait()
				end)
				task.defer(function()
					pcall(function()
						if screenGui and screenGui.Parent then
							screenGui:Destroy()
						end
					end)
				end)
			end)
		else
			pcall(function()
				textBox.Text = ""
				textBox.PlaceholderText = "No Quieres Proyectarte?"
				textBox.PlaceholderColor3 = Color3.fromRGB(255, 85, 85)
				statusLabel.Text = "✖ Key inválida, inténtalo de nuevo"
				statusLabel.TextColor3 = Color3.fromRGB(255, 85, 85)
				tbStroke.Color = Color3.fromRGB(255, 85, 85)
			end)

			task.delay(1.5, function()
				if closing then return end
				pcall(function()
					if tbStroke and tbStroke.Parent then
						tbStroke.Color = Color3.fromRGB(65, 65, 85)
					end
				end)
			end)
		end
	end)

	task.spawn(function()
		task.wait(kickTime)
		if not verified and not closing then
			pcall(function()
				localPlayer:Kick("No podrás Proyectarte junto Nosotros")
			end)
		end
	end)

	while not verified do
		task.wait(0.1)
	end

	return true
end

return KeySystem
