floatingBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        hasMoved = false
        dragStart = input.Position
        startPos = floatingBtn.Position
        local connection
        connection = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                isDragging = false
                connection:Disconnect()
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and isDragging then
        if dragStart then
            local delta = input.Position - dragStart
            if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
                hasMoved = true
                floatingBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end
    end
end)

floatingBtn.MouseButton1Click:Connect(function()
    if not hasMoved and root and not checks.binding and root.Enabled ~= nil then
        root.Enabled = not root.Enabled
    end
end)

local function Resize(part, new, _delay)
	local tweenInfo = TweenInfo.new(_delay or 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(part, tweenInfo, new):Play()
end

local function gNameLen(obj) return obj.TextBounds.X + 15 end
local function gMouse() return Vector2.new(UIS:GetMouseLocation().X + 1, UIS:GetMouseLocation().Y - 35) end

local function ripple(button, x, y)
	runtime:Spawn(function()
		button.ClipsDescendants = true
		local circle = prefabs:FindFirstChild("Circle"):Clone()
		circle.Parent = button
		circle.ZIndex = 1000
		circle.Position = UDim2.new(0, x - circle.AbsolutePosition.X, 0, y - circle.AbsolutePosition.Y)
		local size = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 1.5
		circle:TweenSizeAndPosition(UDim2.new(0, size, 0, size), UDim2.new(0.5, -size / 2, 0.5, -size / 2), "Out", "Quad", 0.5, false, nil)
		Resize(circle, {ImageTransparency = 1}, 0.5)
		wait(0.5)
		circle:Destroy()
	end)
end

local windows = 0
local library = {Runtime = runtime}

function library:AddWindow(title, options)
	if not runtime.Alive then return end
	windows = windows + 1
	options = (typeof(options) == "table") and options or ui_options
	options.tween_time = 0.1

	local Window = prefabs:FindFirstChild("Window"):Clone()
	Window.Parent = windowsFrame
	Window:FindFirstChild("Title").Text = tostring(title or "New Window")
	Window.Size = UDim2.new(0, options.min_size.X, 0, options.min_size.Y)
	Window.ZIndex = Window.ZIndex + (windows * 10)

	local Title = Window:FindFirstChild("Title")
	local Bar = Window:FindFirstChild("Bar")
	local Base = Bar:FindFirstChild("Base")
	local Top = Bar:FindFirstChild("Top")
	local SplitFrame = Window:FindFirstChild("TabSelection"):FindFirstChild("Frame")

	runtime:Spawn(function()
		while true do
			Bar.BackgroundColor3 = options.main_color
			Base.BackgroundColor3 = options.main_color
			Base.ImageColor3 = options.main_color
			Top.ImageColor3 = options.main_color
			SplitFrame.BackgroundColor3 = options.main_color
			RS.Heartbeat:Wait()
		end
	end)

	local Resizer = Window:WaitForChild("Resizer")
	Window.Draggable = true

	local window_data = {}
	
	local oldIcon, Entered = mouse.Icon, false
	runtime:Connect(Resizer.MouseEnter, function()
		Window.Draggable = false
		if options.can_resize then oldIcon = mouse.Icon end
		Entered = true
	end)
	runtime:Connect(Resizer.MouseLeave, function()
		Entered = false
		if options.can_resize then mouse.Icon = oldIcon end
		Window.Draggable = true
	end)

	local Held = false
	runtime:Connect(UIS.InputBegan, function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
			Held = true
			runtime:Spawn(function()
				if Entered and Resizer.Active and options.can_resize then
					while Held and Resizer.Active do
						local mouse_loc = gMouse()
						local x, y = mouse_loc.X - Window.AbsolutePosition.X, mouse_loc.Y - Window.AbsolutePosition.Y
						x = math.max(x, options.min_size.X)
						y = math.max(y, options.min_size.Y)
						Resize(Window, {Size = UDim2.new(0, x, 0, y)}, options.tween_time)
						RS.Heartbeat:Wait()
					end
				end
			end)
		end
	end)
	runtime:Connect(UIS.InputEnded, function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then Held = false end
	end)

	local open_close = Bar:FindFirstChild("Toggle")
	local open, canopen, oldy = true, true, Window.AbsoluteSize.Y
	local oldwindowdata = {}
	
	runtime:Connect(open_close.MouseButton1Click, function()
		if canopen then
			canopen = false
			if open then
				oldwindowdata = {}
				for i,v in pairs(Window:FindFirstChild("Tabs"):GetChildren()) do
					oldwindowdata[v] = v.Visible
					v.Visible = false
				end
				Resizer.Active = false
				oldy = Window.AbsoluteSize.Y
				Resize(Window, {Size = UDim2.new(0, Window.AbsoluteSize.X, 0, 26)}, options.tween_time)
				open_close.Parent:FindFirstChild("Base").Transparency = 1
				open_close.Text = "❤️‍🔥" 
			else
				for i,v in pairs(oldwindowdata) do i.Visible = v end
				Resizer.Active = true
				Resize(Window, {Size = UDim2.new(0, Window.AbsoluteSize.X, 0, oldy)}, options.tween_time)
				open_close.Parent:FindFirstChild("Base").Transparency = 0
				open_close.Text = "📽️" 
			end
			open = not open
			wait(options.tween_time)
			canopen = true
		end
	end)

	local tabs = Window:FindFirstChild("Tabs")
	local tab_selection = Window:FindFirstChild("TabSelection")
	local tab_buttons = tab_selection:FindFirstChild("TabButtons")

	function window_data:AddTab(tab_name)
		local tab_data = {}
		tab_selection.Visible = true

		local new_button = prefabs:FindFirstChild("TabButton"):Clone()
		new_button.Parent = tab_buttons
		new_button.Text = tostring(tab_name or "New Tab")
		new_button.Size = UDim2.new(0, gNameLen(new_button), 0, 20)
		new_button.ZIndex = new_button.ZIndex + (windows * 10)

		local new_tab = prefabs:FindFirstChild("Tab"):Clone()
		new_tab.Parent = tabs
		new_tab.ZIndex = new_tab.ZIndex + (windows * 10)

		local function show()
			for i, v in pairs(tab_buttons:GetChildren()) do
				if not v:IsA("UIListLayout") then
					v:GetChildren()[1].ImageColor3 = Color3.fromRGB(52, 53, 56)
					Resize(v, {Size = UDim2.new(0, v.AbsoluteSize.X, 0, 20)}, options.tween_time)
				end
			end
			for i, v in pairs(tabs:GetChildren()) do v.Visible = false end
			Resize(new_button, {Size = UDim2.new(0, new_button.AbsoluteSize.X, 0, 25)}, options.tween_time)
			new_button:GetChildren()[1].ImageColor3 = Color3.fromRGB(73, 75, 79)
			new_tab.Visible = true
		end

		runtime:Connect(new_button.MouseButton1Click, show)
		function tab_data:Show() show() end

		function tab_data:AddButton(button_text, callback)
			local btn = prefabs:FindFirstChild("Button"):Clone()
			btn.Parent = new_tab
			btn.Text = tostring(button_text or "Button")
			btn.Size = UDim2.new(0, gNameLen(btn), 0, 20)
			
			runtime:Spawn(function()
				while true do
					if btn and btn:GetChildren()[1] then btn:GetChildren()[1].ImageColor3 = options.main_color end
					RS.Heartbeat:Wait()
				end
			end)

			runtime:Connect(btn.MouseButton1Click, function()
				ripple(btn, mouse.X, mouse.Y)
				pcall(callback or function() end)
			end)
			return btn
		end

		function tab_data:AddSwitch(switch_text, callback)
			local switch = prefabs:FindFirstChild("Switch"):Clone()
			switch.Parent = new_tab
			switch:FindFirstChild("Title").Text = tostring(switch_text or "Switch")
			
			runtime:Spawn(function()
				while true do
					if switch and switch:GetChildren()[1] then switch:GetChildren()[1].ImageColor3 = options.main_color end
					RS.Heartbeat:Wait()
				end
			end)

			local toggled = false
			runtime:Connect(switch.MouseButton1Click, function()
				toggled = not toggled
				switch.Text = toggled and utf8.char(10003) or ""
				pcall(callback or function() end, toggled)
			end)
		end

		function tab_data:AddSlider(slider_text, callback, slider_options)
			local slider = prefabs:FindFirstChild("Slider"):Clone()
			slider.Parent = new_tab
			local title = slider:FindFirstChild("Title")
			local indicator = slider:FindFirstChild("Indicator")
			local value = slider:FindFirstChild("Value")
			title.Text = tostring(slider_text or "Slider")
			slider_options = slider_options or {min = 0, max = 100}

			local Entered, Held = false, false
			runtime:Connect(slider.MouseEnter, function() Entered, Window.Draggable = true, false end)
			runtime:Connect(slider.MouseLeave, function() Entered, Window.Draggable = false, true end)
			runtime:Connect(UIS.InputBegan, function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					Held = true
					runtime:Spawn(function()
						while Held and Entered do
							local x = (slider.AbsoluteSize.X - (slider.AbsoluteSize.X - ((gMouse().X - slider.AbsolutePosition.X)) + 1)) / slider.AbsoluteSize.X
							x = math.clamp(x, 0, 1)
							Resize(indicator, {Size = UDim2.new(x, 0, 0, 20)}, options.tween_time)
							local sel_value = math.floor(((slider_options.max - slider_options.min) * x) + slider_options.min)
							value.Text = tostring(sel_value)
							pcall(callback or function() end, sel_value)
							RS.Heartbeat:Wait()
						end
					end)
				end
			end)
			runtime:Connect(UIS.InputEnded, function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then Held = false end
			end)
		end

		return tab_data
	end

	return window_data
end

return library
