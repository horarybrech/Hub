-- FAST FARM TAB
tabs.fastfarm:AddLabel("⚡ Fast Rep (Adaptativo):")

tabs.fastfarm.FastRepData = {
    Running = false,
    WorkerActive = false,
    SendRate = 400,
    MaxSendRate = 800,
    MinSendRate = 100,
    MaxBurst = 32,
    SendTokens = 0,
    LastLoopAt = os.clock(),
    CurrentPing = 0,
    LastPingCheck = 0,
    PingControl = true
}

local networkStats = services.Stats.Network.ServerStatsItem["Data Ping"]

tabs.fastfarm.FastRepStatus = tabs.fastfarm:AddLabel("Status: Inactivo")
tabs.fastfarm.FastRepStatus.TextColor3 = Color3.fromRGB(255, 80, 80)

tabs.fastfarm.FastRepWorkerLoop = function()
    tabs.fastfarm.FastRepData.LastLoopAt = os.clock()
    while _G.FarmUIConnections and tabs.fastfarm.FastRepData.Running do
        local now = os.clock()
        local elapsed = math.min(0.1, now - tabs.fastfarm.FastRepData.LastLoopAt)
        tabs.fastfarm.FastRepData.LastLoopAt = now
        
        if tick() - tabs.fastfarm.FastRepData.LastPingCheck > 0.5 then
            tabs.fastfarm.FastRepData.CurrentPing = networkStats:GetValue()
            tabs.fastfarm.FastRepData.LastPingCheck = tick()
            
            if tabs.fastfarm.FastRepData.PingControl then
                local ping = tabs.fastfarm.FastRepData.CurrentPing
                local targetSpeed
                if ping < 80 then
                    targetSpeed = 800
                elseif ping < 150 then
                    targetSpeed = 600
                elseif ping < 250 then
                    targetSpeed = 400
                elseif ping < 400 then
                    targetSpeed = 200
                else
                    targetSpeed = 100
                end
                tabs.fastfarm.FastRepData.SendRate = targetSpeed
            end
        end
        
        tabs.fastfarm.FastRepData.SendTokens = math.min(
            tabs.fastfarm.FastRepData.MaxBurst,
            tabs.fastfarm.FastRepData.SendTokens + tabs.fastfarm.FastRepData.SendRate * elapsed
        )
        
        local burstLimit = math.max(1, math.min(
            tabs.fastfarm.FastRepData.MaxBurst,
            math.ceil(tabs.fastfarm.FastRepData.SendRate * 0.05)
        ))
        
        local sendCount = math.min(math.floor(tabs.fastfarm.FastRepData.SendTokens), burstLimit)
        
        for i = 1, sendCount do
            pcall(function()
                utils.remotes.MuscleEvent:FireServer("rep")
            end)
        end
        
        tabs.fastfarm.FastRepData.SendTokens = tabs.fastfarm.FastRepData.SendTokens - sendCount
        
        tabs.fastfarm.FastRepStatus.Text = "⚡ " .. math.floor(tabs.fastfarm.FastRepData.SendRate) ..
            " reps/s | " .. math.floor(tabs.fastfarm.FastRepData.CurrentPing) .. " ms"
        tabs.fastfarm.FastRepStatus.TextColor3 = Color3.fromRGB(80, 255, 120)
        
        services.RunService.Heartbeat:Wait()
    end
    tabs.fastfarm.FastRepData.WorkerActive = false
end

tabs.fastfarm:AddTextBox("Max reps/s:", function(text)
