-- =========================================================
-- FAST FARM + FAST REBIRTH TAB (MISMA PESTAÑA)
-- =========================================================
fastTab:AddLabel("⚡ FAST REP:")

-- Fast Rep Data
local fastRepData = {
    Running = false,
    SendRate = 400,
    MaxSendRate = 800,
    MaxBurst = 32,
    SendTokens = 0,
    LastLoopAt = os.clock(),
    CurrentPing = 0,
    LastPingCheck = 0,
    PingControl = true
}

local fastRepStatus = fastTab:AddLabel("Status: Inactivo")

fastTab:AddTextBox("Max reps/s:", function(text)
    local num = tonumber(text)
    if num and num > 0 then
        fastRepData.MaxSendRate = math.clamp(num, 100, 2000)
    end
end, {clear = false})

local pingControlSwitch = fastTab:AddSwitch("Ping Control (Auto Speed)", function(state)
    fastRepData.PingControl = state
end)
pingControlSwitch:Set(true)

local fastRepWorker = function()
    fastRepData.LastLoopAt = os.clock()
    while fastRepData.Running do
        local now = os.clock()
        local elapsed = math.min(0.1, now - fastRepData.LastLoopAt)
        fastRepData.LastLoopAt = now

        if tick() - fastRepData.LastPingCheck > 0.5 then
            fastRepData.CurrentPing = networkStats:GetValue()
            fastRepData.LastPingCheck = tick()

            if fastRepData.PingControl then
                local ping = fastRepData.CurrentPing
                local targetSpeed
                if ping < 80 then
                    targetSpeed = 800
                elseif ping < 150 then
                    targetSpeed = 600
                elseif ping < 250 then
                    targetSpeed = 400
                elseif ping < 400 then
                    targetSpeed = 200
                else
                    targetSpeed = 100
                end
                fastRepData.SendRate = targetSpeed
            end
        end

        fastRepData.SendTokens = math.min(
            fastRepData.MaxBurst,
            fastRepData.SendTokens + fastRepData.SendRate * elapsed
        )

        local burstLimit = math.max(1, math.min(
            fastRepData.MaxBurst,
            math.ceil(fastRepData.SendRate * 0.05)
        ))

        local sendCount = math.min(math.floor(fastRepData.SendTokens), burstLimit)

        for i = 1, sendCount do
            pcall(function()
                muscleEvent:FireServer("rep")
            end)
        end

        fastRepData.SendTokens = fastRepData.SendTokens - sendCount

        fastRepStatus.Text = "⚡ " .. math.floor(fastRepData.SendRate) ..
            " reps/s | " .. math.floor(fastRepData.CurrentPing) .. " ms"

        services.RunService.Heartbeat:Wait()
    end
end

local fastRepSwitch = fastTab:AddSwitch("Fast Rep ⚡", function(state)
    fastRepData.Running = state
    if state then
        fastRepData.SendRate = 400
        fastRepData.SendTokens = 0
        fastRepData.LastLoopAt = os.clock()
        fastRepData.LastPingCheck = tick()
        task.spawn(fastRepWorker)
    else
        fastRepStatus.Text = "Status: Inactivo"
    end
end)

-- =========================================================
-- FAST REBIRTH (MISMA PESTAÑA)
-- =========================================================
fastTab:AddLabel("")
fastTab:AddLabel("🔄 FAST REBIRTH:")

local fastRebirthData = {
    Running = false,
    TargetRebirths = 0,
    IsWorking = false,
    StartRebirths = 0
}

local rebirthStatus = fastTab:AddLabel("Status: Inactivo")
local rebirthStats = fastTab:AddLabel("Rebirths: 0 | Ganados: 0")

fastTab:AddTextBox("Target Rebirths (0 = infinito):", function(text)
    local num = tonumber(text)
    if num and num >= 0 then
        fastRebirthData.TargetRebirths = math.floor(num)
    end
end, {clear = false})

local fastRebirthWorker = function()
    fastRebirthData.StartRebirths = rebirths.Value
    local lastCheck = tick()
    local lastRebirthCount = rebirths.Value

    while fastRebirthData.Running do
        -- Verificar si llegó al target
        if fastRebirthData.TargetRebirths > 0 and rebirths.Value >= fastRebirthData.TargetRebirths then
            rebirthStatus.Text = "Status: ✅ Target alcanzado!"
            fastRebirthData.Running = false
            break
        end

        -- Calcular target strength
        local currentRebirths = rebirths.Value
        local targetStrength = 5000 + currentRebirths * 2550

        rebirthStatus.Text = "Status: 💪 Farmeando... " .. formatNumber(strength.Value) .. " / " .. formatNumber(targetStrength)

        -- Farmear hasta el target
        while fastRebirthData.Running and strength.Value < targetStrength do
            for i = 1, 8 do
                pcall(function()
                    muscleEvent:FireServer("rep")
                end)
            end
            task.wait(0.03)

            rebirthStats.Text = "Rebirths: " .. tostring(rebirths.Value) .. " | Ganados: " .. tostring(rebirths.Value - fastRebirthData.StartRebirths)
        end

        -- Hacer rebirth
        if fastRebirthData.Running and strength.Value >= targetStrength then
            rebirthStatus.Text = "Status: 🔄 Haciendo rebirth..."

            local rebirthValueBefore = rebirths.Value
            local attempts = 0

            repeat
                pcall(function()
                    rebirthRemote:InvokeServer("rebirthRequest")
                end)
                task.wait(0.05)
                attempts = attempts + 1
            until not fastRebirthData.Running or rebirths.Value > rebirthValueBefore or attempts >= 50

            if rebirths.Value > rebirthValueBefore then
                rebirthStatus.Text = "Status: ✅ Rebirth completado!"
                rebirthStats.Text = "Rebirths: " .. tostring(rebirths.Value) .. " | Ganados: " .. tostring(rebirths.Value - fastRebirthData.StartRebirths)
            end
        end

        task.wait(0.5)
    end
    
    rebirthStatus.Text = "Status: Inactivo"
    fastRebirthData.IsWorking = false
end

local fastRebirthSwitch = fastTab:AddSwitch("Fast Rebirth 🔄", function(state)
    fastRebirthData.Running = state
    if state then
        rebirthStatus.Text = "Status: 🔄 Iniciando..."
        if not fastRebirthData.IsWorking then
            fastRebirthData.IsWorking = true
            task.spawn(fastRebirthWorker)
        end
    else
        rebirthStatus.Text = "Status: Inactivo"
        fastRebirthData.IsWorking = false
    end
end)

-- =========================================================
-- STATS TAB
-- =========================================================
statsTab:AddLabel("Progreso:")
statsTab:AddLabel("")

local strengthLabel = statsTab:AddLabel("💪 Strength: 0")
local rebirthLabel = statsTab:AddLabel("🔄 Rebirths: 0")
local killsLabel = statsTab:AddLabel("🎯 Kills: 0")

local startTime = tick()
local timerLabel = statsTab:AddLabel("⏱️ Tiempo: 00:00:00")

-- Actualizar stats
task.spawn(function()
    while true do
        strengthLabel.Text = "💪 Strength: " .. formatNumber(strength.Value)
        rebirthLabel.Text = "🔄 Rebirths: " .. tostring(rebirths.Value)
        
        local kills = leaderstats:FindFirstChild("Kills")
        if kills then
            killsLabel.Text = "🎯 Kills: " .. tostring(kills.Value)
        end

        local elapsed = tick() - startTime
        local hours = math.floor(elapsed / 3600)
        local minutes = math.floor((elapsed % 3600) / 60)
        local seconds = math.floor(elapsed % 60)
        timerLabel.Text = string.format("⏱️ Tiempo: %02d:%02d:%02d", hours, minutes, seconds)

        task.wait(0.5)
    end
end)

