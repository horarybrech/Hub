local function getEquippedPets()
    local equipped = {}
    local seen = {}
    local player = services.Players.LocalPlayer
    local petsFolder = player:FindFirstChild("petsFolder")
    if petsFolder then
        for _, folder in pairs(petsFolder:GetChildren()) do
            if folder:IsA("Folder") and folder.Name ~= "Unique" then
                for _, pet in pairs(folder:GetChildren()) do
                    if not seen[pet.Name] then
                        table.insert(equipped, {Name = pet.Name, Reference = pet})
                        seen[pet.Name] = true
                    end
                end
            end
        end
    end
    local char = player.Character
    if char then
        for _, obj in pairs(char:GetChildren()) do
            if obj:IsA("StringValue") or obj:IsA("ObjectValue") or obj:IsA("Model") or obj:IsA("Folder") then
                if not seen[obj.Name] then
                    table.insert(equipped, {Name = obj.Name, Reference = obj})
                    seen[obj.Name] = true
                end
            end
        end
    end
    for _, obj in pairs(player:GetDescendants()) do
        if obj:GetAttribute("Equipped") == true then
            if not seen[obj.Name] then
                table.insert(equipped, {Name = obj.Name, Reference = obj})
                seen[obj.Name] = true
            end
        end
    end
    return equipped
end

local function startContinuousReequip(savedPets, durationSeconds)
    if not savedPets or #savedPets == 0 then return end
    if not utils.remotes.EquipPetEvent then return end
    local player = services.Players.LocalPlayer
    local petsFolder = player:FindFirstChild("petsFolder")
    local uniqueFolder = petsFolder and petsFolder:FindFirstChild("Unique")
    task.spawn(function()
        local startTime = tick()
        while tick() - startTime < durationSeconds do
            for _, petInfo in ipairs(savedPets) do
                local pet = petInfo.Reference
                if pet and pet.Parent then
                    pcall(function() utils.remotes.EquipPetEvent:FireServer("equipPet", pet) end)
                else
                    if uniqueFolder then
                        for _, p in pairs(uniqueFolder:GetChildren()) do
                            if p.Name == petInfo.Name then
                                pcall(function() utils.remotes.EquipPetEvent:FireServer("equipPet", p) end)
                                petInfo.Reference = p
                                break
                            end
                        end
                    end
                end
            end
            task.wait(0.05)
        end
    end)
end

