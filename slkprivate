                local textR = "Gained: " .. utils.formatWithCommas(gainR) .. " | x1h: " .. utils.formatWithCommas(rH)
                local textT = formatTiempo(elapsed)
                if textS ~= statsData.LastTextS then
                    pcall(function() strengthPara:SetDesc(textS) end)
                    statsData.LastTextS = textS
                end
                if textR ~= statsData.LastTextR then
