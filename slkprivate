function utils.formatNumber(n)
    if not n or n ~= n then return "0" end
    local absN = math.abs(n)
    local sign = n < 0 and "-" or ""
    if absN >= 1e18 then return sign .. string.format("%.1fqi", absN / 1e18)
    elseif absN >= 1e15 then return sign .. string.format("%.1fqa", absN / 1e15)
    elseif absN >= 1e12 then return sign .. string.format("%.1ft", absN / 1e12)
    elseif absN >= 1e9 then return sign .. string.format("%.1fb", absN / 1e9)
    elseif absN >= 1e6 then return sign .. string.format("%.1fm", absN / 1e6)
    elseif absN >= 1e3 then return sign .. string.format("%.1fk", absN / 1e3)
    else return sign .. tostring(math.floor(absN)) end
end

function utils.formatWithCommas(n)
    n = math.floor(n or 0)
    local formatted = tostring(n)
    while true do
        local k
        formatted, k = formatted:gsub("^(-?%d+)(%d%d%d)", "%1.%2")
        if k == 0 then break end
    end
    return formatted
end

function utils.connect(signal, callback)
    return signal:Connect(callback)
end

function utils.equipTrainingTool()
    local char = services.Players.LocalPlayer.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local backpack = services.Players.LocalPlayer:FindFirstChild("Backpack")
    if not hum or not backpack then return nil end
    for _, toolName in ipairs({"Weight", "Pushups", "Situps", "Handstands"}) do
        if char:FindFirstChild(toolName) then return toolName end
    end
    for _, toolName in ipairs({"Weight", "Pushups", "Situps", "Handstands"}) do
        local tool = backpack:FindFirstChild(toolName)
        if tool then
            pcall(function() hum:EquipTool(tool) end)
            task.wait(0.2)
            return toolName
        end
    end
    return nil
end

local privacyRedactor = {}
privacyRedactor.NameEnabled = false
privacyRedactor.StatsEnabled = false
privacyRedactor.OriginalTexts = {}
privacyRedactor.NameGuis = {}
privacyRedactor.PlayerName = services.Players.LocalPlayer.Name
privacyRedactor.PlayerDisplayName = services.Players.LocalPlayer.DisplayName

function privacyRedactor:containsName(text)
    if not text then return false end
    return string.find(text, self.PlayerName, 1, true) or string.find(text, self.PlayerDisplayName, 1, true)
end

function privacyRedactor:redactText(object, replacement)
    if not object or (not object:IsA("TextLabel") and not object:IsA("TextButton")) then return end
    if not self.OriginalTexts[object] then self.OriginalTexts[object] = object.Text end
    if object.Text ~= replacement then object.Text = replacement end
end

function privacyRedactor:hideNameGui(character)
    if not character then return end
    for _, descendant in pairs(character:GetDescendants()) do
        if descendant.Name == "nameGui" and descendant:IsA("BillboardGui") then
            if self.NameGuis[descendant] == nil then self.NameGuis[descendant] = descendant.Enabled end
            descendant.Enabled = false
        end
    end
end

function privacyRedactor:restoreNameGui()
    for gui, originalState in pairs(self.NameGuis) do
        if gui and gui.Parent then gui.Enabled = originalState ~= false end
    end
    self.NameGuis = {}
end

function privacyRedactor:isTopStat(object)
    if not object.Text or not string.find(object.Text, "%d") then return false end
    if object.AbsolutePosition.Y > 200 then return false end
    local current = object
    for _ = 1, 6 do
        if not current then break end
        local name = string.lower(current.Name)
        if string.find(name, "strength", 1, true)
            or string.find(name, "gem", 1, true)
            or string.find(name, "rebirth", 1, true)
            or string.find(name, "durability", 1, true)
            or string.find(name, "agility", 1, true)
            or string.find(name, "kills", 1, true) then
            return true
        end
        current = current.Parent
    end
    return false
end

function privacyRedactor:redactLeaderboardStats(nameObject, coreGui)
    local nameCenterY = nameObject.AbsolutePosition.Y + nameObject.AbsoluteSize.Y / 2
    local minimumX = nameObject.AbsolutePosition.X + nameObject.AbsoluteSize.X * 0.5
    local tolerance = math.max(6, nameObject.AbsoluteSize.Y * 0.5)
    for _, valueObject in pairs(coreGui:GetDescendants()) do
        if (valueObject:IsA("TextLabel") or valueObject:IsA("TextButton"))
            and valueObject ~= nameObject and string.find(valueObject.Text, "%d") then
            local valueCenterY = valueObject.AbsolutePosition.Y + valueObject.AbsoluteSize.Y / 2
            if valueObject.AbsolutePosition.X >= minimumX and math.abs(valueCenterY - nameCenterY) <= tolerance then
                self:redactText(valueObject, "####")
            end
        end
    end
end

function privacyRedactor:update()
    local coreGui = game:GetService("CoreGui")
    local player = services.Players.LocalPlayer
    local character = player.Character
    if self.NameEnabled and character then self:hideNameGui(character) end
    for _, object in pairs(coreGui:GetDescendants()) do
        if object:IsA("TextLabel") or object:IsA("TextButton") then
            if self:containsName(object.Text) then
                if self.StatsEnabled then self:redactLeaderboardStats(object, coreGui) end
                if self.NameEnabled then self:redactText(object, "########") end
            end
        end
    end
    if self.StatsEnabled then
        for _, object in pairs(player:WaitForChild("PlayerGui"):GetDescendants()) do
            if (object:IsA("TextLabel") or object:IsA("TextButton")) and self:isTopStat(object) then
                self:redactText(object, "####")
            end
        end
    end
end

function privacyRedactor:restore()
    for object, originalText in pairs(self.OriginalTexts) do
        if object and object.Parent then
            pcall(function() object.Text = originalText end)
        end
    end
    self.OriginalTexts = {}
    self:restoreNameGui()
end

function privacyRedactor:setNameEnabled(state)
    self.NameEnabled = state
    if not state then
        for object, originalText in pairs(self.OriginalTexts) do
            if object and object.Parent and self:containsName(originalText) then
                pcall(function() object.Text = originalText end)
                self.OriginalTexts[object] = nil
            end
        end
        self:restoreNameGui()
    end
end

function privacyRedactor:setStatsEnabled(state)
    self.StatsEnabled = state
    if not state then
        for object, originalText in pairs(self.OriginalTexts) do
            if object and object.Parent and not self:containsName(originalText) then
                pcall(function() object.Text = originalText end)
                self.OriginalTexts[object] = nil
            end
        end
    end
end

task.spawn(function()
    while true do
        if privacyRedactor.NameEnabled or privacyRedactor.StatsEnabled then
            pcall(function() privacyRedactor:update() end)
        end
        task.wait(1)
    end
end)

